#!/bin/bash
# The demo. One command, then one key press, repeatedly.
#
#   ./demo          set everything up and wait for ⌃⌥C
#   ./demo stop     put it all away
#
# Deliberately NOT run-demo.sh. That script starts a task itself, prints a
# summary and exits — which is right for testing and wrong for a stage, where
# the trigger is a key press and you want to do it more than once without
# retyping anything. This stays up: press ⌃⌥C, watch, press again.
set -uo pipefail
cd "$(dirname "$0")"

[ "${1:-}" = stop ] && { ./run-demo.sh stop; exit 0; }

# Voices, devices and pacing all come from run-demo.sh so there is exactly one
# place that decides them.
export CREW_AUDIO_DEVICE="${CREW_AUDIO_DEVICE:-MacBook Pro Speakers}"
export CREW_VOICE_TRIAGE="${CREW_VOICE_TRIAGE:-Moira}"
export CREW_VOICE_SCHEDULER="${CREW_VOICE_SCHEDULER:-Daniel}"
export CREW_VOICE_RECAP="${CREW_VOICE_RECAP:-Karen}"
if [ -z "${CREW_SAY:-}" ] && ls crew-dock/voices/*.onnx >/dev/null 2>&1; then
  export CREW_SAY="$PWD/crew-dock/crew-say"
  export LINE_MS="${LINE_MS:-5500}"
fi

./run-demo.sh stop >/dev/null 2>&1

# Being ON main is not the same as being UP TO DATE with it — four other people
# push to this branch all day. Say so rather than expecting anyone to remember a
# git command before a demo. Never pulls by itself: a rebase seconds before you
# present is a worse idea than running one commit behind.
git fetch -q origin 2>/dev/null
BEHIND=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
if [ "${BEHIND:-0}" -gt 0 ]; then
  echo
  echo "  ℹ️  $BEHIND new commit(s) on origin/main that you do not have."
  echo "     git pull --rebase origin main   (then ./demo again)"
  echo "     — or carry on; what you have works, it is just not the newest."
fi

# Rebuild if the sources moved. C's guard, because a `git pull` that brings new
# Swift otherwise leaves you demoing the previous build with no warning.
DOCK_BIN=crew-dock/Crew.app/Contents/MacOS/Crew
if [ ! -x "$DOCK_BIN" ] || [ -n "$(find crew-dock/Sources crew-dock/build.sh -newer "$DOCK_BIN" 2>/dev/null)" ]; then
  printf 'building the dock... '; ./crew-dock/build.sh >/dev/null && echo ok
fi

"$DOCK_BIN" > /tmp/crew-dock.log 2>&1 &
sleep 2
grep -q 'listening on :4002' /tmp/crew-dock.log || {
  echo "the dock never bound :4002:"; cat /tmp/crew-dock.log; exit 1; }

node orchestrator/server.js > /tmp/crew-orchestrator.log 2>&1 &
for _ in $(seq 1 20); do curl -sf -o /dev/null localhost:4001/status/x && break; sleep 0.3; done

# The one thing that silently stops the key press working, said up front rather
# than discovered by pressing it and getting nothing.
if grep -q 'hotkey OFF' /tmp/crew-dock.log; then
  echo
  echo "  ⚠️  ⌃⌥C WILL DO NOTHING — the dock has no Accessibility permission."
  echo "     System Settings → Privacy & Security → Accessibility → add Terminal (or Crew)."
  echo "     Then run ./demo again."
fi

# The one step no script can do, said before you need it rather than after it
# silently fails. `fn` cannot be synthesized — rebinding to an ordinary chord was
# tried and VoiceOS does not see posted events either. So hands-free is one human
# press, ONCE, and it stays on: after that ⌃⌥C greets you and you simply talk.
cat <<'BANNER'

  ────────────────────────────────────────────────────────────
    ready.

      HOLD  ⌃⌥  ...and keep holding while you talk...  LET GO

    one gesture. the crew arrives as you press, listens while
    you hold, and goes to work the moment you let go.

    ctrl-C here to stop.
  ────────────────────────────────────────────────────────────

BANNER

# Follow the narration for as long as you keep pressing. `stop` on the way out
# whichever way we leave, so the next run never fights a leftover port.
trap './run-demo.sh stop >/dev/null 2>&1; echo; echo "stopped."; exit 0' INT TERM
tail -f /tmp/crew-orchestrator.log | grep --line-buffered -Ev '^orchestrator on|waking up'
