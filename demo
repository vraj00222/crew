#!/bin/bash
# The demo. One command, then one key press, repeatedly.
#
#   ./demo          set everything up and wait for ⌃⌥C
#   ./demo real     the agents' voices really drive VoiceOS
#   ./demo phone    the crew can text you, ring you, and ASK you mid-run
#   ./demo phone-fake  the same act, simulated — no key, no tunnel, no network
#   ./demo stop     put it all away
#
# Deliberately NOT run-demo.sh. That script starts a task itself, prints a
# summary and exits — which is right for testing and wrong for a stage, where
# the trigger is a key press and you want to do it more than once without
# retyping anything. This stays up: press ⌃⌥C, watch, press again.
set -uo pipefail
cd "$(dirname "$0")"

[ "${1:-}" = stop ] && { ./run-demo.sh stop; exit 0; }

# `./demo real` — the agents' voices actually drive VoiceOS.
#
# You hold VoiceOS's Agent Mode chord while they work, because Agent Mode is a
# held key and an agent cannot hold one. The crew speaks its commands into
# BlackHole; VoiceOS, listening there and in agent mode because you are holding
# it, really makes the note and really sets the reminder. The dock keeps
# narrating to the speakers, so the room hears the characters and VoiceOS never
# hears them — the split that `spike.sh split` measures.
REAL=""
if [ "${1:-}" = real ]; then
  REAL=1
  export CREW_MODE=voice
  # Everyone speaks into the SAME microphone — you and the crew. No BlackHole,
  # no mid-run device handover: that switching is what kept leaving VoiceOS
  # deaf, because a pinned device breaks whichever half is not using it.
  #
  # The dock goes quiet in this mode so the only voice in the room is the crew
  # instructing VoiceOS. Which is the better demo anyway: the audience HEARS it
  # being told what to do, instead of watching it happen silently.
  export CREW_MUTE=1
  SwitchAudioSource -t input -s "${CREW_HUMAN_MIC:-MacBook Pro Microphone}" >/dev/null 2>&1
fi

# `./demo phone` — the run where the crew reaches you off the laptop. direct
# mode, because the phone tools are crew_* tools and only direct-mode agents
# hold them. The stack itself (voice server, tunnel, pointing the number) comes
# up below, in parallel with the dock, so it costs no extra wall time on stage.
PHONE=""
if [ "${1:-}" = phone ]; then
  PHONE=1
  export CREW_MODE=direct
fi

# `./demo phone-fake` — the same third act with nothing outside this laptop in
# the path. The real phone needs five things to be up at once (team key,
# verified number, voice server, tunnel, transcription); this needs none of
# them, and the dock performs the calling and the answer identically. It is to
# the phone what `./run-demo.sh fake` is to the agents, and it is what you reach
# for when the venue wifi decides the demo is over.
if [ "${1:-}" = phone-fake ]; then
  export CREW_MODE=direct CREW_PHONE_FAKE=1
fi

# Voices, devices and pacing all come from run-demo.sh so there is exactly one
# place that decides them.
export CREW_AUDIO_DEVICE="${CREW_AUDIO_DEVICE:-MacBook Pro Speakers}"
# The task worth showing: three apps, and the result is checkable in front of
# whoever is watching — open Notes and Reminders afterwards and it is all there.
export CREW_PHRASE_LONG="${CREW_PHRASE_LONG:-look at all the events on my calendar this week, work out the theme of them, email me a summary, and set a reminder for each one}"
export CREW_VOICE_TRIAGE="${CREW_VOICE_TRIAGE:-Moira}"
export CREW_VOICE_SCHEDULER="${CREW_VOICE_SCHEDULER:-Daniel}"
export CREW_VOICE_RECAP="${CREW_VOICE_RECAP:-Karen}"
if [ -z "${CREW_SAY:-}" ] && ls crew-dock/voices/*.onnx >/dev/null 2>&1; then
  export CREW_SAY="$PWD/crew-dock/crew-say"
  export LINE_MS="${LINE_MS:-5500}"
fi

./run-demo.sh stop >/dev/null 2>&1 &
STOPPING=$!

# The behind-check costs ~1.7s of network on every start, which is a long time
# to stand in front of a room. Off by default; CREW_CHECK_GIT=1 brings it back.
if [ "${CREW_CHECK_GIT:-}" = 1 ]; then
  git fetch -q origin 2>/dev/null
  BEHIND=$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)
  [ "${BEHIND:-0}" -gt 0 ] && echo "  ℹ️  $BEHIND commit(s) behind origin/main"
fi

wait $STOPPING 2>/dev/null

# Rebuild if the sources moved. C's guard, because a `git pull` that brings new
# Swift otherwise leaves you demoing the previous build with no warning.
DOCK_BIN=crew-dock/Crew.app/Contents/MacOS/Crew
if [ ! -x "$DOCK_BIN" ] || [ -n "$(find crew-dock/Sources crew-dock/build.sh -newer "$DOCK_BIN" 2>/dev/null)" ]; then
  printf 'building the dock... '; ./crew-dock/build.sh >/dev/null && echo ok
fi

# Both at once, and poll instead of sleeping. This used to take 4-5s of fixed
# waits before a character could appear; nothing here needs to be sequential.
: > /tmp/crew-dock.log
"$DOCK_BIN" > /tmp/crew-dock.log 2>&1 &
node orchestrator/server.js > /tmp/crew-orchestrator.log 2>&1 &

# Alongside the dock, not after it. Standing up a tunnel and pointing the number
# takes the better part of ten seconds, and that is ten seconds of a presenter
# watching a blank screen if it is done in sequence. The dock is on screen while
# this happens; we only join it below, before saying "ready".
PHONE_PID=""
if [ -n "$PHONE" ]; then
  ./voiceos-bridge/mcp-server/phone.sh up > /tmp/crew-phone.log 2>&1 &
  PHONE_PID=$!
fi

for _ in $(seq 1 100); do
  grep -q 'listening on :4002' /tmp/crew-dock.log 2>/dev/null \
    && curl -sf -o /dev/null localhost:4001/tasks 2>/dev/null && break
  sleep 0.05
done
grep -q 'listening on :4002' /tmp/crew-dock.log || {
  echo "the dock never bound :4002:"; cat /tmp/crew-dock.log; exit 1; }

# Join the phone stack before claiming to be ready. A failure here is loud but
# never fatal: every other tool still works, and a demo missing one trick beats
# no demo. The log is printed rather than summarised because the fix is always
# in it — a dead tunnel, an unverified number, a missing key.
if [ -n "$PHONE_PID" ]; then
  printf '  bringing the phone up... '
  if wait "$PHONE_PID"; then
    echo "ready — the crew can reach you on ${CREW_PHONE:-<CREW_PHONE unset>}"
  else
    echo "FAILED"
    sed -n '1,40p' /tmp/crew-phone.log | sed 's/^/     /'
    echo "     the crew will run without the phone. ./voiceos-bridge/mcp-server/phone.sh check"
  fi
fi

# The one thing that silently stops the key press working, said up front rather
# than discovered by pressing it and getting nothing.
if grep -q 'hotkey OFF' /tmp/crew-dock.log; then
  echo
  echo "  ⚠️  ⌃⌥C WILL DO NOTHING — the dock has no Accessibility permission."
  echo "     System Settings → Privacy & Security → Accessibility → add Terminal (or Crew)."
  echo "     Then run ./demo again."
fi

# The one step no script can do, said before you need it rather than after it
# silently fails. `fn` cannot be synthesized — rebinding to an ordinary chord was
# tried and VoiceOS does not see posted events either. So hands-free is one human
# press, ONCE, and it stays on: after that ⌃⌥C greets you and you simply talk.
cat <<'BANNER'

  ────────────────────────────────────────────────────────────
    ready.

      HOLD  fn   ...keep holding while you talk...   LET GO

    that is the whole thing. one key, held.
    (⌃⌥ works too — but VoiceOS acts on that one itself.)

    ctrl-C here to stop.
  ────────────────────────────────────────────────────────────

BANNER
[ -n "$REAL" ] && cat <<'REALBANNER'
  ⚡ REAL MODE — the crew will actually do things.

     after you let go, HOLD  control + shift  and keep holding
     while they work. that is VoiceOS's Agent Mode, and it is
     what turns their words into real notes and reminders.

     let go when the last character signs off.

REALBANNER
[ -n "$PHONE" ] && cat <<'PHONEBANNER'
  📞 PHONE MODE — the crew can reach you away from the laptop.

     ask for it out loud and they do it:
       "...and text me when it's done"
       "...call me with the summary"

     and when they get STUCK, your phone rings. answer it,
     say what you want in one sentence, hang up. what you said
     is transcribed and handed straight back to the agent, and
     the rest of the crew closes the show knowing it.

PHONEBANNER
[ "${CREW_PHONE_FAKE:-}" = 1 ] && cat <<'FAKEPHONEBANNER'
  📵 PHONE SIMULATED — no phone will ring, nothing leaves this laptop.

     the characters still say they are calling you, still say what
     you "said", and the crew still works from that answer. only
     the ringing is missing, and only you know that.

FAKEPHONEBANNER

# Follow the narration for as long as you keep pressing. `stop` on the way out
# whichever way we leave, so the next run never fights a leftover port.
trap './run-demo.sh stop >/dev/null 2>&1; echo; echo "stopped."; exit 0' INT TERM
tail -f /tmp/crew-orchestrator.log | grep --line-buffered -Ev '^orchestrator on|waking up'
