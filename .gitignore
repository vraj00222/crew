node_modules/
*.log
.DS_Store
.claude/settings.local.json

# VoiceOS config holds live auth tokens — never commit it, even if copied here.
config.json

# A filled-in .env. The template (.env.example) is committed; the real one never is.
.env
.env.*
!.env.example

# crew-dock build output. Crew.app is compiled, never committed.
crew-dock/Crew.app/

# Upstream art (lil-agents, MIT) — 18MB, fetched by build.sh, not ours to commit.
# Named individually rather than ignoring the whole Assets/ directory: git does
# not descend into an excluded directory, so a `!` exception inside one is never
# consulted and D's original art could not be committed at all. Ignoring the two
# upstream files by name has no such trap — anything D draws is committable with
# no further edits here.
crew-dock/Assets/walk-bruce-01.mov
crew-dock/Assets/walk-jazz-01.mov

# local run output from the bridge/orchestrator test scripts
*.out
*.err

# demo-seed credentials — OAuth client secret + cached user token. NEVER commit.
voiceos-bridge/demo-seed/credentials.json
voiceos-bridge/demo-seed/token.json

# fake-backend mailbox state, regenerated from fixtures.json
voiceos-bridge/mcp-server/.crew-mailbox.json

# Piper voice models — ~63MB each, fetched by ./crew-dock/voices.sh piper-install
crew-dock/voices/*.onnx

# a1mobile hackathon credentials — team key is a live API credential
ai-mobile-integration.md
.a1mobile-state.json
# what real people said on real calls — never commit
voiceos-bridge/mcp-server/call-log.jsonl
voiceos-bridge/mcp-server/.report-mark
